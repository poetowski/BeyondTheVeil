VITE_API_BASE_URL=http://localhost:8000

# --- Deploying to Render ---
# This app deploys as a single Render web service that serves both the
# API and the built frontend (see render.yaml), so in production
# VITE_API_BASE_URL should be set to an empty string - requests then go
# to a relative path (e.g. /api/v1/...), resolved against whatever origin
# served the page, instead of a separate backend URL. Vite bakes this in
# at build time, so it must be set in Render's build environment, not
# just at runtime. Only set it to a real URL (like the localhost default
# above) for local dev, where the frontend and backend run as two
# separate dev servers.
