DATABASE_URL=postgresql+psycopg2://beyondtheveil:beyondtheveil@localhost:5432/beyondtheveil
JWT_SECRET_KEY=change-me-in-production
VEIL_DURATION_SECONDS=300
FRONTEND_ORIGIN=http://localhost:5173

# --- Deploying to Render + Neon ---
# DATABASE_URL: use the Neon connection string, with `?sslmode=require`
#   appended (Neon requires SSL). Example:
#   postgresql+psycopg2://user:password@ep-example-123456.us-east-2.aws.neon.tech/beyondtheveil?sslmode=require
# JWT_SECRET_KEY: set a real random secret in Render's dashboard - never
#   commit a real value here.
# FRONTEND_ORIGIN: the deployed frontend's URL (e.g.
#   https://beyondtheveil.onrender.com). Comma-separate multiple origins
#   (e.g. a custom domain plus the onrender.com URL) if needed.
